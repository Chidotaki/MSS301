    {
      "name": "KB1 - Happy path",
      "item": [
        {
          "name": "[KB1] 1. Snapshot kho & ví",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{inventoryUrl}}/api/inventory/products"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.response.json().forEach(p => pm.collectionVariables.set(\"stock_\" + p.id, p.stock));",
                  "pm.sendRequest(pm.collectionVariables.get(\"paymentUrl\") + \"/api/payments/wallets\", (err, res) => {",
                  "  pm.test(\"Đọc được số dư ví\", () => pm.expect(err).to.be.null);",
                  "  if (!err) res.json().forEach(w => pm.collectionVariables.set(\"bal_\" + w.customerId, w.balance));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "[KB1] 2. Đặt hàng",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{orderUrl}}/api/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"C1\",\n  \"productId\": \"P1\",\n  \"quantity\": 2,\n  \"amount\": 2000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const o = pm.response.json();",
                  "pm.collectionVariables.set(\"kb1OrderId\", o.id);",
                  "pm.test(\"Order status = CONFIRMED\", () => pm.expect(o.status).to.eql(\"CONFIRMED\"));",
                  "pm.test(\"Saga status = COMPLETED\", () => pm.expect(o.sagaStatus).to.eql(\"COMPLETED\"));",
                  "pm.test(\"failureReason = null\", () => pm.expect(o.failureReason).to.be.null);"
                ]
              }
            }
          ]
        },
        {
          "name": "[KB1] 3. Kiểm tra kho & ví",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{inventoryUrl}}/api/inventory/products"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const expectStock = {\"P1\": -2};",
                  "const expectBal = {\"C1\": -2000};",
                  "pm.response.json().forEach(p => {",
                  "  if (p.id in expectStock) {",
                  "    const before = Number(pm.collectionVariables.get(\"stock_\" + p.id));",
                  "    pm.test(`Tồn kho ${p.id} đúng`, () => pm.expect(p.stock).to.eql(before + expectStock[p.id]));",
                  "  }",
                  "});",
                  "pm.sendRequest(pm.collectionVariables.get(\"paymentUrl\") + \"/api/payments/wallets\", (err, res) => {",
                  "  pm.test(\"Đọc được số dư ví\", () => pm.expect(err).to.be.null);",
                  "  if (!err) res.json().forEach(w => {",
                  "    if (w.customerId in expectBal) {",
                  "      const before = Number(pm.collectionVariables.get(\"bal_\" + w.customerId));",
                  "      pm.test(`Số dư ${w.customerId} đúng`, () => pm.expect(w.balance).to.eql(before + expectBal[w.customerId]));",
                  "    }",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "[KB1] 4. Saga logs",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{orderUrl}}/api/orders/{{kb1OrderId}}/saga-logs"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const steps = pm.response.json().map(x => x.step);",
                  "pm.test(\"Thứ tự bước Saga đúng\", () => pm.expect(steps).to.eql([\"CREATE_ORDER\", \"RESERVE_INVENTORY\", \"PROCESS_PAYMENT\", \"CONFIRM_ORDER\"]));"
                ]
              }
            }
          ]
        }
      ]
    },
